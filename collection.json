    {
      "name": "Booking Service",
      "description": "Endpoints pour la gestion des réservations (service sur le port 8082).",
      "item": [
        {
          "name": "Bookings",
          "description": "Création et consultation des réservations de salles.",
          "item": [
            {
              "name": "Créer une réservation",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"userEmail\": \"{{booking_user_email}}\",\n  \"startTime\": \"{{booking_start_time}}\",\n  \"endTime\": \"{{booking_end_time}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{booking_base_url}}/api/v1/bookings",
                  "host": [
                    "{{booking_base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "bookings"
                  ]
                },
                "description": "Crée une réservation pour une salle existante. Les dates sont générées automatiquement dans le futur à chaque exécution."
              },
              "response": [],
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const start = new Date(Date.now() + 60 * 60 * 1000);",
                      "const end = new Date(start.getTime() + 60 * 60 * 1000);",
                      "pm.collectionVariables.set('booking_start_time', start.toISOString());",
                      "pm.collectionVariables.set('booking_end_time', end.toISOString());"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 201 attendu\", function () {",
                      "  pm.response.to.have.status(201);",
                      "});",
                      "pm.test(\"Entête Location présent\", function () {",
                      "  pm.expect(pm.response.headers.has('Location')).to.be.true;",
                      "});",
                      "pm.test(\"Identifiant de réservation capturé\", function () {",
                      "  const json = pm.response.json();",
                      "  pm.expect(json.id).to.exist;",
                      "  pm.collectionVariables.set('bookingId', json.id);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Récupérer une réservation",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{booking_base_url}}/api/v1/bookings/{{bookingId}}",
                  "host": [
                    "{{booking_base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "bookings",
                    "{{bookingId}}"
                  ]
                },
                "description": "Récupère une réservation existante à partir de son identifiant. Mettre à jour {{bookingId}} après la création d'une réservation."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 200 ou 404\", function () {",
                      "  pm.expect([200, 404]).to.include(pm.response.code);",
                      "});",
                      "if (pm.response.code === 200) {",
                      "  const json = pm.response.json();",
                      "  pm.expect(json.id).to.eql(pm.collectionVariables.get('bookingId'));",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
