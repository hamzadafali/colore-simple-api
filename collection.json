                  ]
                },
                "description": "Endpoint Spring Boot Actuator pour vérifier la santé du room-service."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 200 attendu\", function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Statut UP\", function () {",
                      "  const json = pm.response.json();",
                      "  pm.expect(json.status).to.eql('UP');",
                      "});"
                    ]
                  }
                }
