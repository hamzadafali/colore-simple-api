{
  "info": {
    "name": "CoworkSimple API",
    "_postman_id": "3a665d67-842a-4edf-8c38-5ec6b4b54883",
    "description": "Collection Postman pour interagir avec les services Room et Booking de la plateforme CoworkSimple. Les requêtes incluent des scripts de tests et de préparation pour accélérer les parcours métiers principaux.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Room Service",
      "description": "Endpoints principaux pour la gestion des salles (service sur le port 8081).",
      "item": [
        {
          "name": "Rooms",
          "description": "Opérations CRUD sur les salles.",
          "item": [
            {
              "name": "Lister les salles",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{room_base_url}}/api/v1/rooms",
                  "host": [
                    "{{room_base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "rooms"
                  ]
                },
                "description": "Récupère la liste complète des salles disponibles. Exécuter après la création d'une salle pour valider l'apparition de la nouvelle entrée."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 200 attendu\", function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Réponse JSON est un tableau\", function () {",
                      "  const json = pm.response.json();",
                      "  pm.expect(Array.isArray(json)).to.be.true;",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Récupérer une salle",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{room_base_url}}/api/v1/rooms/{{roomId}}",
                  "host": [
                    "{{room_base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "rooms",
                    "{{roomId}}"
                  ]
                },
                "description": "Récupère une salle par son identifiant unique. Exécuter après avoir mis à jour la variable {{roomId}} (création ou import)."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 200 ou 404\", function () {",
                      "  pm.expect([200, 404]).to.include(pm.response.code);",
                      "});",
                      "if (pm.response.code === 200) {",
                      "  const json = pm.response.json();",
                      "  pm.expect(json.id).to.exist;",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Créer une salle",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{room_name}}\",\n  \"capacity\": {{room_capacity}}\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{room_base_url}}/api/v1/rooms",
                  "host": [
                    "{{room_base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "rooms"
                  ]
                },
                "description": "Crée une nouvelle salle. Le nom doit être unique et la capacité >= 1. La réponse capture automatiquement l'identifiant dans la variable de collection {{roomId}}."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 201 attendu\", function () {",
                      "  pm.response.to.have.status(201);",
                      "});",
                      "pm.test(\"Entête Location présent\", function () {",
                      "  pm.expect(pm.response.headers.has('Location')).to.be.true;",
                      "});",
                      "pm.test(\"Identifiant de salle capturé\", function () {",
                      "  const json = pm.response.json();",
                      "  pm.expect(json.id).to.exist;",
                      "  pm.collectionVariables.set('roomId', json.id);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Mettre à jour une salle",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"{{room_name_updated}}\",\n  \"capacity\": {{room_capacity_update}}\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{room_base_url}}/api/v1/rooms/{{roomId}}",
                  "host": [
                    "{{room_base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "rooms",
                    "{{roomId}}"
                  ]
                },
                "description": "Met à jour le nom et/ou la capacité d'une salle existante. Les conflits de nom renvoient 409 CONFLICT."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 200 ou 204\", function () {",
                      "  pm.expect([200, 204]).to.include(pm.response.code);",
                      "});",
                      "if (pm.response.code === 200) {",
                      "  const json = pm.response.json();",
                      "  pm.collectionVariables.set('roomId', json.id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Supprimer une salle",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{room_base_url}}/api/v1/rooms/{{roomId}}",
                  "host": [
                    "{{room_base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "rooms",
                    "{{roomId}}"
                  ]
                },
                "description": "Supprime une salle existante. L'opération est idempotente : aucune erreur si l'identifiant n'existe pas."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 204 attendu\", function () {",
                      "  pm.response.to.have.status(204);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
