                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 200 attendu\", function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test(\"Entête X-Cowork-Server-Time présent\", function () {",
                      "  pm.expect(pm.response.headers.has('X-Cowork-Server-Time')).to.be.true;",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Room Service - Health",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{room_base_url}}/actuator/health",
