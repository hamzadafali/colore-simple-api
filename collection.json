                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{room_base_url}}/actuator/info",
                  "host": [
                    "{{room_base_url}}"
                  ],
                  "path": [
                    "actuator",
                    "info"
                  ]
                },
                "description": "Métadonnées supplémentaires du room-service exposées par Spring Boot Actuator."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Statut 200 attendu\", function () {",
                      "  pm.response.to.have.status(200);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
